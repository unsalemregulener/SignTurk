# ─────────────────────────────────────────────────────────
#  SignaTurk — örnek ortam değişkenleri
#  Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
#  `.env` git'e EKLENMEZ (.gitignore'da) — gerçek token'ı oraya yazın.
#     cp .env.example .env
# ─────────────────────────────────────────────────────────

# Hugging Face Inference API token'ı (cümle motorunun ML kolu için).
# huggingface.co/settings/tokens → Create new token → "Read" yetkisi yeterli.
# BOŞ bırakılırsa ML kapalı kalır; sistem kural-tabanlı (rule-based) çalışır.
HF_TOKEN=

# ── ML cümle motoru (opsiyonel, varsayılan kapalı) ────────
# Yalnızca /api/text/correct rotası için. İstek gövdesinde
# {"use_ml": true} göndererek de tek tek açabilirsiniz.
# Aşağıdakileri ayarlamak ZORUNLU DEĞİL — varsayılanlar yeterli.

# Tüm ML kolunu env üzerinden açmak isterseniz (1 = açık):
# SIGNAI_USE_ML_GRAMMAR=0

# Kullanılacak model anahtarı (varsayılan: qwen2.5-7b-api).
# Daha az halüsinasyon için alternatif: qwen3-8b-api
# SIGNAI_GRAMMAR_MODEL_KEY=qwen2.5-7b-api

# PostgreSQL baglanti dizesi (kendi veritabanin)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
