# Copy this file to .env and fill in what you need. Never commit .env.

# Database. Leave empty to use a local SQLite file (local_dev.db).
# PostgreSQL / Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Origins allowed to call the API from a browser (comma separated).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# First administrator. Created at startup when both values are set and the
# email is not registered yet. Startup fails if the password is shorter
# than 8 characters.
SIGNTURK_ADMIN_NAME=SignTurk Admin
SIGNTURK_ADMIN_EMAIL=
SIGNTURK_ADMIN_PASSWORD=

# How long a sign-in stays valid, in hours.
# SIGNTURK_TOKEN_HOURS=12

# ── 226-sign full mode ──────────────────────────────────────
# Needs: python tools/download_models.py --bundle 226
# SIGNTURK_ENABLE_226=1           # 0 skips loading it
# SIGNTURK_226_DETECT_EVERY=1     # run the person detector on every Nth frame

# ── Optional ML grammar layer (off by default) ──────────────
# Hugging Face token for the Inference API (read access is enough).
# Without it the sentence engine stays rule-based.
HF_TOKEN=
# SIGNAI_USE_ML_GRAMMAR=0
# SIGNAI_GRAMMAR_MODEL_KEY=qwen2.5-7b-api
# SIGNAI_GRAMMAR_MODEL=            # raw Hugging Face model id, overrides the key
# SIGNAI_GRAMMAR_MODEL_ARCH=       # seq2seq | causal | inference-api
# SIGNAI_PROMPT_VERSION=zs-1

# ── Optional server-side speech for /api/text/* ─────────────
# The web interface speaks through the browser; these only affect the API.
# SIGNAI_TTS_ENGINE=auto           # auto | gtts | piper
# SIGNAI_TTS_OFFLINE=0             # 1 = try Piper first
# SIGNAI_PIPER_VOICE=              # path to a Piper .onnx voice

# ── Text API tuning ─────────────────────────────────────────
# SIGNAI_PIPELINE_CACHE_MAX=3
# SIGNAI_PIPELINE_CACHE_TTL=1800
# SIGNAI_JOB_MAX=64
# SIGNAI_JOB_TTL=300
# SIGNAI_ASYNC_WORKERS=2
